{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Posthaste",
  "version": "0.2.0",
  "identifier": "dev.posthaste.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Capture a thought from anywhere.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNkVENDM5RTYwNUZDQ0MKUldUTS9BWG1PZFJ1ZXJxTTNuaEhlMkpNeTF4TlJZQW1IRGZoRmNDS1czL0lacGEyOUxpZXNoL1QK",
      "endpoints": [
        "https://github.com/worty76/Posthaste/releases/latest/download/latest.json"
      ]
    }
  }
}
